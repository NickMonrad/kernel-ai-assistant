  "shots": [
    {
      "id": "S00",
      "feature": "Home screen: Jandal widgets, icon and Lists shortcut",
      "caption": "Jandal AI on your home screen",
      "offline": true,
      "steps": [
        {
          "do": "sleep",
          "s": 2.5,
          "start_here": true,
          "note": "Hold on the demo home page"
        },
        {
          "do": "launch",
          "note": "Jandal opens (sync anchor); S01 handles the tabs, so S00 ends as the app appears",
          "tabs": false
        },
        {
          "do": "sleep",
          "s": 0.3
        }
      ],
      "setup": [
        {
          "do": "home_page",
          "swipes_env": "DEMO_HOME_SWIPES",
          "note": "Not recorded: the other home pages hold personal widgets"
        }
      ]
    },
    {
      "id": "S01",
      "feature": "Hey Jandal",
      "caption": "Optional \"Hey Jandal\" wake word",
      "offline": true,
      "needs_source_device": true,
      "steps": [
        {
          "do": "launch"
        },
        {
          "do": "tap",
          "text": "Actions"
        },
        {
          "do": "sleep",
          "s": 1.5
        },
        {
          "do": "host",
          "env": "DEMO_WAKE_CMD",
          "note": "Plays \"Hey Jandal\" then \"What time is it?\" in Lokhor's cloned voice from the S21, the same path as #1329 J10 (not the private natural_wake fixture, which must not appear in a public video). Device audio is not recorded; the fixtures' start times go into the manifest and the same WAVs are mixed in, so this span plays at real speed",
          "args": [
            "--sequence",
            "demo_s01_wake,demo_s01_time"
          ]
        },
        {
          "do": "wait",
          "text": "It's",
          "new": true,
          "timeout": 20
        },
        {
          "do": "wait_speech",
          "until_done": false,
          "timeout": 20,
          "compress": true,
          "compress_to": 0.6,
          "note": "The wait for synthesis is sped up; the speech itself plays at real speed (demo_edit keeps it out of the sped-up span)"
        },
        {
          "do": "sleep",
          "s": 1.5
        }
      ]
    },
    {
      "id": "S02",
      "feature": "Lists, Kiwi phrasing",
      "caption": "Lists that understand Kiwi",
      "offline": true,
      "steps": [
        {
          "do": "launch"
        },
        {
          "do": "tap",
          "text": "Actions"
        },
        {
          "do": "voice",
          "fixture": "demo_s02_bananas",
          "says": "Stick bananas on the grocery list",
          "note": "Cloned-voice fixture played from the S21 at real speed; its start time goes into the manifest's audio list for the mix. 'Chuck' was dropped: offline, Android's on-device recogniser heard it as 'check' every time (online 4/4), and Vosk worse. 'Stick', 'pop' and 'toss' were each heard 2/2 offline"
        },
        {
          "do": "wait",
          "text": "shopping list",
          "new": true,
          "timeout": 15,
          "note": "The result is a list card titled with the list name, not a sentence"
        },
        {
          "do": "wait_speech",
          "until_done": false,
          "timeout": 20,
          "compress": true,
          "compress_to": 0.6,
          "note": "The wait for synthesis is sped up; the speech itself plays at real speed (demo_edit keeps it out of the sped-up span)"
        },
        {
          "do": "tap",
          "text": "Tools",
          "compress": true,
          "compress_to": 0.4
        },
        {
          "do": "tap",
          "text": "Lists",
          "compress": true,
          "compress_to": 0.4
        },
        {
          "do": "tap",
          "text": "shopping list",
          "compress": true,
          "compress_to": 0.4
        },
        {
          "do": "wait",
          "text": "bananas",
          "timeout": 10
        }
      ],
      "needs_source_device": true
    },
    {
      "id": "S03",
      "feature": "Timer and alarm",
      "caption": "Timers and alarms, instantly",
      "offline": true,
      "steps": [
        {
          "do": "launch"
        },
        {
          "do": "tap",
          "text": "Actions"
        },
        {
          "do": "tap",
          "desc": "Run quick action"
        },
        {
          "do": "type",
          "text": "Set a timer for 10 minutes",
          "compress": true,
          "compress_to": 0.8
        },
        {
          "do": "wait",
          "text": "Timer set for",
          "new": true,
          "timeout": 15
        },
        {
          "do": "tap",
          "desc": "Run quick action",
          "compress": true,
          "compress_to": 0.3
        },
        {
          "do": "type",
          "text": "Set an alarm for 7am tomorrow",
          "compress": true,
          "compress_to": 0.8
        },
        {
          "do": "wait",
          "text": "Alarm set for",
          "new": true,
          "timeout": 15
        }
      ],
      "teardown": [
        {
          "do": "tap",
          "desc": "Run quick action"
        },
        {
          "do": "type",
          "text": "Cancel the timer"
        },
        {
          "do": "sleep",
          "s": 3
        },
        {
          "do": "tap",
          "desc": "Run quick action"
        },
        {
          "do": "type",
          "text": "Cancel my 7am alarm"
        },
        {
          "do": "sleep",
          "s": 3
        }
      ],
      "teardown_note": "Cancels the shot's timer and alarm after recording. 'Cancel my 7am alarm' cancels the next app alarm, which is the one S03 just set"
    },
    {
      "id": "S04",
      "feature": "Memory and recall",
      "caption": "Remembers what matters — stored on your device",
      "offline": true,
      "model": true,
      "steps": [
        {
          "do": "launch"
        },
        {
          "do": "tap",
          "text": "Chats"
