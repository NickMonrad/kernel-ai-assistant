    {
      "id": "S07B",
      "feature": "Nextcloud sync, the item on the user's own server (Nextcloud Tasks web page, S23U browser)",
      "caption": "Optional sync with your own Nextcloud",
      "offline": false,
      "redact_env": [
        "DEMO_NC_SERVER",
        "DEMO_NC_USER"
      ],
      "redact_env_optional": [
        "DEMO_NC_DISPLAY_NAME"
      ],
      "steps": [
        {
          "do": "launch",
          "note": "Sync anchor; the cut starts at the browser opening"
        },
        {
          "do": "open_url",
          "env": "DEMO_NC_SERVER",
          "path_env": "DEMO_NC_TASKS_PATH",
          "path": "/apps/tasks/",
          "start_here": true,
          "note": "DEMO_NC_TASKS_PATH opens the shopping list directly, so the Tasks sidebar (other accounts' shared lists) is never shown"
        },
        {
          "do": "wait",
          "text": "cheese",
          "timeout": 60,
          "compress": true,
          "compress_to": 1.5
        },
        {
          "do": "sleep",
          "s": 1.2,
          "note": "Real-time hold so the shot does not end under the sped-up marker"
        }
