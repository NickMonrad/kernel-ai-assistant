          "appear_timeout": 4,
          "timeout": 300,
          "note": "After the app was backgrounded the model reloads; this is before the first input, so it is cut"
        },
        {
          "do": "voice",
          "fixture": "demo_s04_remember_coffee",
          "says": "Remember that my favourite coffee is a flat white",
          "mic_text": "PTT"
        },
        {
          "do": "wait_gone",
          "desc": "Cancel response",
          "timeout": 240,
          "compress": true
        },
        {
          "do": "wait_speech",
          "until_done": true,
          "timeout": 20,
          "compress": true,
          "compress_to": 0.6,
          "note": "The wait for synthesis is sped up; the speech itself plays at real speed (demo_edit keeps it out of the sped-up span)"
        },
        {
          "do": "sleep",
          "s": 1
        },
        {
          "do": "tap",
          "desc": "New conversation",
          "compress": true,
          "compress_to": 0.3
        },
        {
          "do": "voice",
          "fixture": "demo_s04_ask_coffee",
          "says": "What's my favourite coffee?",
          "mic_text": "PTT"
        },
        {
          "do": "wait_gone",
          "desc": "Cancel response",
          "timeout": 240,
          "compress": true
        },
        {
          "do": "wait",
          "text": "flat white",
          "timeout": 5
        },
        {
          "do": "wait_speech",
          "until_done": true,
          "timeout": 20,
          "compress": true,
          "compress_to": 0.6,
          "note": "The wait for synthesis is sped up; the speech itself plays at real speed (demo_edit keeps it out of the sped-up span)"
        },
        {
          "do": "voice",
          "fixture": "demo_s04_ask_birthday",
          "says": "When is my wife's birthday?",
          "mic_text": "PTT",
          "note": "Seeded important date (invented): 'Save my wife's birthday as 14 March'"
        },
        {
          "do": "wait",
          "text": "Until",
          "new": true,
          "timeout": 30,
          "note": "get_date_diff card: '127 days — Until …'"
        },
        {
          "do": "wait_speech",
          "until_done": false,
          "timeout": 20,
          "compress": true,
          "compress_to": 0.6,
          "note": "The wait for synthesis is sped up; the speech itself plays at real speed (demo_edit keeps it out of the sped-up span)"
        },
        {
          "do": "sleep",
          "s": 1.5
        }
