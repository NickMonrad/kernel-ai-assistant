<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.kernel.ai.debug.acoustic.AcousticStimulusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kernel.ai.debug.action.PLAY_ACOUSTIC_STIMULUS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.kernel.ai.debug.journal.TargetEventJournalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kernel.ai.debug.action.GET_JOURNAL_SEQUENCE" />
                <action android:name="com.kernel.ai.debug.action.GET_JOURNAL_SNAPSHOT" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.kernel.ai.debug.journal.TargetEventJournalProvider"
            android:authorities="${applicationId}.target-event-journal"
            android:exported="true" />
        <provider
            android:name="com.kernel.ai.debug.transcript.LocalLlmToolsTranscriptProvider"
            android:authorities="${applicationId}.local-llm-tools-transcript"
            android:exported="true" />
        <receiver
            android:name="com.kernel.ai.debug.verifier.WakeVerifierProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kernel.ai.debug.action.VERIFY_WAKE_WINDOW" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.kernel.ai.debug.inflect.InflectSpikeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kernel.ai.debug.action.RUN_INFLECT_RUNTIME_PROBE" />
                <action android:name="com.kernel.ai.debug.action.RUN_INFLECT_GRAPH_PROBE" />
                <action android:name="com.kernel.ai.debug.action.CANCEL_INFLECT_GRAPH_PROBE" />
            </intent-filter>
        </receiver>
        <!-- Explicit-component-only control endpoint (#1410): no intent filter,
             so only targeted broadcasts with -n reach it. -->
        <receiver
            android:name="com.kernel.ai.debug.wake.WakeDetectorRearmReceiver"
            android:exported="true" />
    </application>

</manifest>
