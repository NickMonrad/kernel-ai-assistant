{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NickMonrad/kernel-ai-assistant/scripts/testdata/test_evidence.schema.json",
  "title": "Normalised Test Evidence",
  "description": "Normalised schema for test evidence from CI and on-device runs. See docs/testing/test-evidence-schema.md for documentation.",
  "type": "object",
  "required": [
    "schema_version", "source", "suite", "timestamp", "repo",
    "branch", "commit", "pr", "release", "run_id",
    "device", "model", "summary", "cases"
  ],
  "allOf": [
    {
      "description": "CI source must use CI-only device shape and null model",
      "if": {
        "properties": { "source": { "const": "ci" } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "execution": { "enum": ["github_hosted_runner"] },
              "tier": { "enum": ["ci"] }
            }
          },
          "model": {
            "properties": {
              "name": { "type": "null" },
              "runtime": { "type": "null" },
              "backend": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "description": "on_device source must use physical device shape with non-null model and non-ci tier",
      "if": {
        "properties": { "source": { "const": "on_device" } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "device": {
            "properties": {
              "execution": { "enum": ["physical"] },
              "tier": { "enum": ["reference", "tracked", "experimental"] }
            }
          },
          "model": {
            "properties": {
              "name": { "type": "string" },
              "runtime": { "type": "string" },
              "backend": { "type": "string" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semver for the schema. '1.0' initially.",
      "pattern": "^\\d+\\.\\d+$"
    },
    "source": {
      "type": "string",
      "description": "Test evidence source type.",
      "enum": ["on_device", "ci"]
    },
    "suite": {
      "type": "string",
      "description": "Test suite identifier, e.g. 'llm_tools', 'skills', 'unit'."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the test run started."
    },
    "repo": {
      "type": "string",
      "description": "GitHub 'owner/repo'.",
      "pattern": "^[^/]+/[^/]+$"
    },
    "branch": {
      "type": "string",
      "description": "Git branch the run was against."
    },
    "commit": {
      "type": "string",
      "description": "Full 40-character commit SHA.",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pr": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ],
      "description": "PR number, or null for non-PR runs."
    },
    "release": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Release tag, or null."
    },
    "run_id": {
      "type": "string",
      "description": "Unique run identifier. Convention: '<source>-<timestamp>-<device-id>'."
    },
    "device": {
      "type": "object",
      "description": "Device or CI runner metadata.",
      "required": ["id", "label", "manufacturer", "model", "soc", "tier", "android_api", "execution"],
      "properties": {
        "id": { "type": "string" },
        "serial": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "label": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "soc": { "type": "string" },
        "tier": { "type": "string", "enum": ["reference", "tracked", "experimental", "ci"] },
        "android_api": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "execution": { "type": "string", "enum": ["physical", "github_hosted_runner"] }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "description": "Model/runtime metadata.",
      "required": ["name", "runtime", "backend"],
      "properties": {
        "name": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "runtime": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "backend": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "description": "Pass/fail summary counts.",
      "required": ["total", "passed", "failed", "pass_rate"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "description": "Per-case results.",
      "items": {
        "type": "object",
        "required": [
          "name", "passed",
          "expected_tool", "actual_tool",
          "expected_result_mode", "actual_result_mode",
          "chip_present", "skill_result_present", "message_saved",
          "retry_seen", "slot_fill_seen",
          "failure_category", "failures"
        ],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "expected_tool": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "actual_tool": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "expected_result_mode": {
            "type": "string",
            "enum": ["success", "direct_reply"]
          },
          "actual_result_mode": {
            "type": "string",
            "enum": ["success", "direct_reply", "unknown"]
          },
          "chip_present": { "type": "boolean" },
          "skill_result_present": { "type": "boolean" },
          "message_saved": { "type": "boolean" },
          "retry_seen": { "type": "boolean" },
          "slot_fill_seen": { "type": "boolean" },
          "failure_category": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "harness_error",
                  "missing_marker",
                  "model_tool_generation_miss",
                  "wrong_tool",
                  "wrong_result_mode",
                  "field_mismatch",
                  "conversational_fallback",
                  "retry_seen",
                  "slot_fill_seen",
                  "device_environment_error",
                  "timeout"
                ]
              },
              { "type": "null" }
            ]
          },
          "failures": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
